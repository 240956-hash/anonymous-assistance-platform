# Examples only. Set these variables in your shell; this file is not auto-loaded.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# SQLite is used only for local development. PostgreSQL configuration:
DB_ENGINE=sqlite
DB_NAME=aap
DB_USER=aap
DB_PASSWORD=replace-locally
DB_HOST=127.0.0.1
DB_PORT=5432
